{
  "name": "backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:docker": "tsx watch --include 'src/**/*' src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "start:prod": "node dist/src/server.js",
    "test": "tsx --test test/**/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
